{
  "schema_version": 3,
  "project_id": "HPC",
  "wave": {
    "file_regex": "^W(?P<number>\\d{2})(?:\\.(?P<part>[1-9]))?\\.md$",
    "id_format": "W{number:02d}",
    "min": 1,
    "max": 73
  },
  "paths": {
    "pending": "waves/pending",
    "done": "waves/done",
    "blocked": "waves/blocked",
    "postponed": "waves/postponed",
    "active_wave_tracker": null,
    "waves_index": null
  },
  "capabilities": {
    "active_wave_tracker": false,
    "waves_index": false,
    "canonical_source_closeout": false,
    "closed_owner_repair_transaction": true
  },
  "scheduler": {
    "authority": "wave_directories",
    "auto_resume": true,
    "selection_mode": "pending_only",
    "closed_wave_policy": "immutable"
  },
  "aggregate": {
    "validator_script": "scripts/validate_wave_closeout.py",
    "owner_wave_ids": []
  },
  "final_validation": {
    "enabled": true,
    "validator_script": "scripts/validate_wave_closeout.py",
    "canonical_wave_ids": [
      "W62",
      "W63",
      "W64",
      "W65",
      "W66",
      "W67",
      "W68",
      "W69",
      "W70",
      "W71",
      "W72",
      "W73"
    ],
    "require_all_manifests": true,
    "blocked_state": "PROGRAM_FINAL_VALIDATION_BLOCKED"
  },
  "protocols": {
    "canonical_root": ".agents/protocol",
    "execution": ".agents/protocol/AC_WAVE_EXECUTION_AND_TEST_PROTOCOL.md",
    "evidence_schema": ".agents/protocol/AC_WAVE_VALIDATION_EVIDENCE_SCHEMA.md",
    "program_orchestration": ".agents/protocol/AC_WAVE_PROGRAM_ORCHESTRATION.md",
    "real_infrastructure": ".opencode/protocol/LOCAL_REAL_HPC_LAB.md"
  },
  "backend": {
    "codex": {
      "skill_root": ".agents/skills",
      "state_engine": ".opencode/scripts/wave_state_engine.py",
      "program_controller": ".opencode/scripts/run-wave-program.py"
    },
    "opencode": {
      "skill_root": ".agents/skills",
      "adapter_root": ".opencode",
      "standalone_required": true
    }
  },
  "temp_root": ".tmp",
  "legacy_run_roots": [
    ".agent-runs"
  ],
  "global_state_owner": "controller",
  "evidence": {
    "identity": "content",
    "manifest_template": "artifacts/wave_{wave_id}/WAVE_{wave_id}_EVIDENCE_MANIFEST.json",
    "shared_requirement_ids": [],
    "accepted_statuses": [
      "ACCEPTANCE_GREEN",
      "CLOSED"
    ],
    "allowed_closeout_only_paths": [
      "docs/wave-reports/",
      "artifacts/",
      "build/audit/",
      ".tmp/",
      "waves/",
      "scripts/validate_wave_closeout.py",
      ".opencode/scripts/run-wave-program.py",
      "scripts/run-wave-program-direct.py",
      "scripts/direct_executor.py",
      "scripts/direct_phase_bridge.py",
      ".opencode/protocol/WAVE_PROJECT_PROFILE.json",
      "tests/test_wave_controller_regressions.py"
    ],
    "required_manifest_fields": [
      "spec_profile_id",
      "protocol_revision",
      "wave_id",
      "wave_spec_revision",
      "status",
      "candidate_sha",
      "closure_sha",
      "dependency_validation",
      "requirements",
      "tests",
      "gui_actions",
      "resources",
      "artifacts",
      "review_passes",
      "contradiction_scan",
      "blockers",
      "deferred_items",
      "validator_result"
    ]
  },
