{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trubagui.local/schemas/deepseek-packet-verdict-v1.json",
  "title": "TRUBAGUI DeepSeek Packet Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "wave",
    "packet",
    "verdict",
    "verifiedBy",
    "verifiedAt",
    "relatedRunIds",
    "allowedPaths",
    "observedPaths",
    "diffStat",
    "testsRun",
    "evidenceFiles",
    "reviewFindings",
    "resolutions",
    "remainingUncertainty",
    "capacity",
    "nextPermittedPacket"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "wave": { "type": "string", "minLength": 1 },
    "packet": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["PASS", "FAIL", "SPLIT", "NEEDS_RECHECK", "BLOCKED"] },
    "verifiedBy": { "type": "string", "minLength": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "relatedRunIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedPaths": { "type": "array", "items": { "type": "string" } },
    "observedPaths": { "type": "array", "items": { "type": "string" } },
    "diffStat": { "type": "array", "items": { "type": "string" } },
    "testsRun": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "outcome", "evidenceFile"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "outcome": { "enum": ["PASS", "FAIL", "SKIPPED"] },
          "evidenceFile": { "type": ["string", "null"] }
        }
      }
    },
    "evidenceFiles": { "type": "array", "items": { "type": "string" } },
    "reviewFindings": { "type": "array", "items": { "type": "string" } },
    "resolutions": { "type": "array", "items": { "type": "string" } },
    "remainingUncertainty": { "type": "array", "items": { "type": "string" } },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "maxFiles", "maxChangedLines", "observedFiles", "observedChangedLines", "withinLimit"],
      "properties": {
        "size": { "enum": ["Audit", "Small", "Medium", "Reserved"] },
        "maxFiles": { "type": "integer", "minimum": 0 },
        "maxChangedLines": { "type": "integer", "minimum": 0 },
        "observedFiles": { "type": "integer", "minimum": 0 },
        "observedChangedLines": { "type": "integer", "minimum": 0 },
        "withinLimit": { "type": "boolean" }
      }
    },
    "nextPermittedPacket": { "type": ["string", "null"] }
  }
}
